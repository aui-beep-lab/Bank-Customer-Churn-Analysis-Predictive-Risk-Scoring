```{r}
# ==============================================================================
# 3. MODELING & EVALUATION
# ==============================================================================

model_data <- data %>% select(-customer_id, -age_group, -tenure_group)

train_index <- createDataPartition(model_data$churn, p = 0.7, list = FALSE)
train_data  <- model_data[train_index, ]
test_data   <- model_data[-train_index, ]

ctrl <- trainControl(method = "cv", number = 5, classProbs = TRUE,
                      summaryFunction = twoClassSummary, savePredictions = "final")

roc_list <- list()
cm_list  <- list()

model_rf <- train(churn ~ ., data = train_data, method = "rf", trControl = ctrl, metric = "ROC", tuneLength = 3)
pred_rf  <- predict(model_rf, test_data)
prob_rf  <- predict(model_rf, test_data, type = "prob")[, "Yes"]
cm_list$`Random Forest` <- confusionMatrix(pred_rf, test_data$churn, positive = "Yes")
roc_list$`Random Forest` <- roc(test_data$churn, prob_rf, quiet = TRUE, levels = c("No", "Yes"), direction = "<")

model_xgb <- train(churn ~ ., data = train_data, method = "xgbTree", trControl = ctrl, metric = "ROC", tuneLength = 2, verbosity = 0)
pred_xgb  <- predict(model_xgb, test_data)
prob_xgb  <- predict(model_xgb, test_data, type = "prob")[, "Yes"]
cm_list$XGBoost <- confusionMatrix(pred_xgb, test_data$churn, positive = "Yes")
roc_list$XGBoost <- roc(test_data$churn, prob_xgb, quiet = TRUE, levels = c("No", "Yes"), direction = "<")

model_tree <- train(churn ~ ., data = train_data, method = "rpart", trControl = ctrl, metric = "ROC", tuneLength = 3)
pred_tree  <- predict(model_tree, test_data)
prob_tree  <- predict(model_tree, test_data, type = "prob")[, "Yes"]
cm_list$`Decision Tree` <- confusionMatrix(pred_tree, test_data$churn, positive = "Yes")
roc_list$`Decision Tree` <- roc(test_data$churn, prob_tree, quiet = TRUE, levels = c("No", "Yes"), direction = "<")

model_log <- train(churn ~ ., data = train_data, method = "glm", family = "binomial", trControl = ctrl, metric = "ROC")
pred_log  <- predict(model_log, test_data)
prob_log  <- predict(model_log, test_data, type = "prob")[, "Yes"]
cm_list$`Logistic Regression` <- confusionMatrix(pred_log, test_data$churn, positive = "Yes")
roc_list$`Logistic Regression` <- roc(test_data$churn, prob_log, quiet = TRUE, levels = c("No", "Yes"), direction = "<")

model_knn <- train(churn ~ ., data = train_data, method = "knn", trControl = ctrl, metric = "ROC", tuneLength = 5, preProcess = c("center", "scale"))
pred_knn  <- predict(model_knn, test_data)
prob_knn  <- predict(model_knn, test_data, type = "prob")[, "Yes"]
cm_list$KNN <- confusionMatrix(pred_knn, test_data$churn, positive = "Yes")
roc_list$KNN <- roc(test_data$churn, prob_knn, quiet = TRUE, levels = c("No", "Yes"), direction = "<")

extract_metrics <- function(cm, model_name, auc_val) {
  tibble(Model = model_name, Accuracy = cm$overall[["Accuracy"]], Kappa = cm$overall[["Kappa"]],
         Sensitivity = cm$byClass[["Sensitivity"]], Specificity = cm$byClass[["Specificity"]],
         Balanced_Accuracy = cm$byClass[["Balanced Accuracy"]], AUC = auc_val)
}

metrics_df <- bind_rows(lapply(names(cm_list), function(m) {
  extract_metrics(cm_list[[m]], m, as.numeric(auc(roc_list[[m]])))
})) %>% arrange(desc(AUC))

print(metrics_df)
write_csv(metrics_df, "outputs/tables/model_comparison.csv")

p_compare <- metrics_df %>% pivot_longer(-Model, names_to = "Metric", values_to = "Value") %>%
  ggplot(aes(Model, Value, fill = Metric)) + geom_col(position = "dodge") +
  scale_y_continuous(limits = c(0, 1)) +
  labs(title = "Model Performance Comparison", x = NULL, y = "Score") +
  theme(axis.text.x = element_text(angle = 30, hjust = 1)) + scale_fill_brewer(palette = "Set2")
save_plot(p_compare, "16_model_comparison", width = 9, height = 5.5)

save_base_plot({
  plot(roc_list[[1]], col = 1, main = "ROC Curves — All Models")
  for (i in seq_along(roc_list)[-1]) plot(roc_list[[i]], col = i, add = TRUE)
  legend("bottomright", legend = paste0(names(roc_list), " (AUC=",
         round(sapply(roc_list, function(r) as.numeric(auc(r))), 3), ")"),
         col = seq_along(roc_list), lwd = 2, cex = 0.8)
}, "17_roc_curves.png")

# --- Confusion matrix heatmaps, all 5 models ---
plot_confusion <- function(cm, model_name) {
  df <- as.data.frame(cm$table)
  colnames(df) <- c("Prediction", "Actual", "Freq")
  ggplot(df, aes(Actual, Prediction, fill = Freq)) +
    geom_tile(color = "white") +
    geom_text(aes(label = Freq), size = 4) +
    scale_fill_gradient(low = "#EAF2FB", high = "#4C72B0") +
    labs(title = model_name, x = "Actual", y = "Predicted") +
    theme(legend.position = "none")
}
cm_plots <- lapply(names(cm_list), function(m) plot_confusion(cm_list[[m]], m))
p_confusion_grid <- wrap_plots(cm_plots, ncol = 3) +
  plot_annotation(title = "Confusion Matrices — All Models")
save_plot(p_confusion_grid, "18_confusion_matrices", width = 12, height = 7)

best_model_name <- metrics_df$Model[1]
cat("Best model by AUC:", best_model_name, "\n")

models_lookup <- list("Random Forest" = model_rf, "XGBoost" = model_xgb,
                       "Decision Tree" = model_tree, "Logistic Regression" = model_log, "KNN" = model_knn)
best_model <- models_lookup[[best_model_name]]

saveRDS(models_lookup, "models/all_models.rds")
saveRDS(best_model,    "models/best_model.rds")
saveRDS(metrics_df, "models/model_comparison.rds")

imp <- tryCatch(varImp(best_model)$importance, error = function(e) NULL)
if (!is.null(imp)) {
  imp_df <- imp %>% rownames_to_column("Feature")
  names(imp_df)[2] <- "Importance"
  imp_df <- imp_df %>% arrange(desc(Importance)) %>% head(15)
  p_imp <- ggplot(imp_df, aes(reorder(Feature, Importance), Importance)) +
    geom_col(fill = "forestgreen") + coord_flip() +
    labs(title = paste("Feature Importance —", best_model_name), x = "Feature", y = "Importance")
  save_plot(p_imp, "19_feature_importance")
}
