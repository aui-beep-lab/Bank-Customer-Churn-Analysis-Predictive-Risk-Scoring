```{r}
# ==============================================================================
# 4. PREDICTIVE RISK SCORING
# ==============================================================================

model_input <- data %>% select(-customer_id, -age_group, -tenure_group)
risk_prob <- predict(best_model, model_input, type = "prob")[, "Yes"]

risk_scores <- data %>%
  transmute(customer_id, country, gender, age, tenure, balance, products_number,
            has_cr_card, is_active, estimated_salary,
            actual_churn = churn, churn_probability = round(risk_prob, 4)) %>%
  mutate(risk_tier = factor(case_when(
    churn_probability >= 0.70 ~ "High",
    churn_probability >= 0.40 ~ "Medium",
    TRUE ~ "Low"
  ), levels = c("Low", "Medium", "High"))) %>%
  arrange(desc(churn_probability))

write_csv(risk_scores, "outputs/tables/customer_risk_scores.csv")

p_dist <- ggplot(risk_scores, aes(churn_probability, fill = risk_tier)) +
  geom_histogram(bins = 30, boundary = 0) +
  scale_fill_manual(values = c(Low = "#55A868", Medium = "#DD8452", High = "#C44E52")) +
  labs(title = "Predicted Churn Risk Distribution", x = "Predicted Churn Probability",
       y = "Customers", fill = "Risk Tier")
save_plot(p_dist, "20_risk_distribution")

lift_table <- risk_scores %>%
  mutate(decile = ntile(desc(churn_probability), 10)) %>%
  group_by(decile) %>%
  summarise(n_customers = n(), n_actual_churn = sum(actual_churn == "Yes"),
            churn_rate = round(mean(actual_churn == "Yes") * 100, 2)) %>%
  arrange(decile) %>%
  mutate(cumulative_churn_captured = round(cumsum(n_actual_churn) / sum(n_actual_churn) * 100, 1))

write_csv(lift_table, "outputs/tables/lift_table.csv")

p_lift <- ggplot(lift_table, aes(decile, cumulative_churn_captured)) +
  geom_line(color = "#4C72B0", linewidth = 1) + geom_point(color = "#4C72B0", size = 2) +
  geom_abline(intercept = 10, slope = 10, linetype = "dashed", color = "grey50") +
  scale_x_continuous(breaks = 1:10) +
  labs(title = "Cumulative Lift Chart", subtitle = "Dashed line = random targeting baseline",
       x = "Risk Decile (1 = highest risk)", y = "% of Churners Captured")
save_plot(p_lift, "21_lift_chart")

cat("Targeting decile 1 alone captures", lift_table$cumulative_churn_captured[1], "% of all churners.\n")
