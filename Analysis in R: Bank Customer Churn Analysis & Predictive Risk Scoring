raw_data <- read_csv(raw_path, show_col_types = FALSE) %>% clean_names()
cat("Raw dimensions:", paste(dim(raw_data), collapse = " x "), "\n")
glimpse(raw_data)

expected_cols <- c("customer_id", "credit_score", "country", "gender", "age",
                   "tenure", "balance", "products_number", "credit_card",
                   "active_member", "estimated_salary", "churn")
missing_cols <- setdiff(expected_cols, names(raw_data))
if (length(missing_cols) > 0) {
  stop("Expected column(s) not found in raw data: ", paste(missing_cols, collapse = ", "))
}

cat("Duplicate customer_id rows:", sum(duplicated(raw_data$customer_id)), "\n")

data <- raw_data %>%
  distinct(customer_id, .keep_all = TRUE) %>%
  mutate(
    credit_score      = as.numeric(gsub(",", "", credit_score)),
    balance           = as.numeric(gsub(",", "", balance)),
    estimated_salary  = as.numeric(gsub(",", "", estimated_salary)),
    age               = as.numeric(age),
    tenure            = as.numeric(tenure),
    products_number   = as.numeric(products_number),
    gender            = factor(gender, levels = c("Male", "Female")),
    country           = factor(country),
    has_cr_card       = factor(credit_card,   levels = c(0, 1), labels = c("No", "Yes")),
    is_active         = factor(active_member, levels = c(0, 1), labels = c("No", "Yes")),
    churn             = factor(churn,         levels = c(0, 1), labels = c("No", "Yes"))
  ) %>%
  select(customer_id, credit_score, country, gender, age, tenure, balance,
         products_number, has_cr_card, is_active, estimated_salary, churn)

missing_summary <- data %>%
  summarise(across(everything(), ~ sum(is.na(.)))) %>%
  pivot_longer(everything(), names_to = "column", values_to = "n_missing") %>%
  filter(n_missing > 0)
cat("\nMissing values before imputation:\n"); print(missing_summary)

impute_col <- function(x) {
  if (is.numeric(x)) {
    x[is.na(x)] <- median(x, na.rm = TRUE)
  } else if (is.factor(x)) {
    x[is.na(x)] <- names(sort(table(x), decreasing = TRUE))[1]
  }
  x
}
data <- data %>% mutate(across(everything(), impute_col))
stopifnot(sum(is.na(data)) == 0)

data <- data %>%
  mutate(
    age_group    = cut(age, breaks = c(17, 30, 50, 100), labels = c("<30", "30-50", ">50")),
    tenure_group = cut(tenure, breaks = c(-1, 2, 5, 10), labels = c("0-2 yrs", "3-5 yrs", "6-10 yrs")),
    salary_flag_zero_balance = balance == 0
  )

cat("\nFinal cleaned dimensions:", paste(dim(data), collapse = " x "), "\n")
cat("Churn rate:", round(mean(data$churn == "Yes") * 100, 2), "%\n")

saveRDS(data, "data/processed/churn_clean.rds")
write_csv(data, "data/processed/churn_clean.csv")
